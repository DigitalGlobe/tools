        amdb_support::display_bt_int_data(page, env, highlights,
            numHighlights, g, normalColor, highlightColor, width, height);
    } else {
        amdb_support::display_bt_int_pred(page, env, highlights,
            numHighlights, g, normalColor, highlightColor, width, height);
    }
}

