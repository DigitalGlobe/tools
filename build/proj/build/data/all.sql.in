INSERT INTO "helmert_transformation" VALUES('EPSG','9688','GDA94 to WGS 84 (2)','Concatenation of CTs 8048 and 8450 through GDA2020. Scale difference in ppb where 1/billion = 1E-9. See GDA94 to WGS 84 (2) (CT code 9689) for alternative for Australia including distortion model.','EPSG','9607','Coordinate Frame rotation (geog2D domain)','EPSG','4283','EPSG','4326',3.0,61.55,-10.87,-40.19,'EPSG','1025',-39.4924,-32.7221,-32.8979,'EPSG','1031',-9.994,'EPSG','1028',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,'ICSM-Aus Conf',0);
