INSERT INTO "grid_transformation" VALUES('EPSG','9888','NTF to RGF93 v2 (1)','Parameter file is from NTF to RGF93 v1 (code 9327), assuming that RGF93 v1 is equivalent to RGF93 v2 within the accuracy of the transformation. May be emulated using NTv2 method - see CT code 9890.','EPSG','1087','Geocentric translation by Grid Interpolation (IGN)','EPSG','4275','EPSG','9777',1.0,'EPSG','8727','Geocentric translation file','gr3df97a.txt',NULL,NULL,NULL,NULL,'EPSG','9777','IGN-Fra 1m',0);
