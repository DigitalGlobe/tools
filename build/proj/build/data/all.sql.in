INSERT INTO "grid_transformation" VALUES('EPSG','10161','ETRS89 to S34J-IRF (1)','In conjunction with the S34-reconstruction map projection (code 10159) applied to S34J-IRF (code 10158), enables transformation of coordinates between the historic CRS S34J and ETRS89. File is also available in GeoTIFF format (s34j_2022.tif).','EPSG','9615','NTv2','EPSG','4258','EPSG','10158',0.03,'EPSG','8656','Latitude and longitude difference file','s34j_2022.gsb',NULL,NULL,NULL,NULL,NULL,NULL,'SDFI-Den Jy 2022',0);
