INSERT INTO "helmert_transformation" VALUES('EPSG','10589','ITRF2014 to Segara (1)','Replaces transformation Segara to WGS 84 (4) (code 1838). Computed by PT Pageo Utama and PT Bhumi Warih Geohydromatics in May 2023. Transformation parameters were derived at epoch 2022.00.','EPSG','9607','Coordinate Frame rotation (geog2D domain)','EPSG','9000','EPSG','4613',0.2,407.379,-685.226,-52.577,'EPSG','9001',-0.318,0.107,-0.058,'EPSG','9104',0.207,'EPSG','9202',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,'PHM-Idn Mhk 2023',0);
