INSERT INTO "grid_transformation" VALUES('EPSG','10624','ETRS89 to ECML14-IRF (1)','In conjunction with the ECML14-TM map projection (code 10625) applied to ECML14-IRF (code 10623), emulates the ECML14 Snake projection. Applied to ETRS89 (as realized through the OSNet v2009) defines ECML14-IRF hence is errorless.						','EPSG','9615','NTv2','EPSG','4258','EPSG','10623',0.0,'EPSG','8656','Latitude and longitude difference file','TN15-ETRS89-to-ECML14-IRF.gsb',NULL,NULL,NULL,NULL,NULL,NULL,'NR-Gbr ECML14 OSNet2009',0);
