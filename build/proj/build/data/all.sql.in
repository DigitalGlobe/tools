INSERT INTO "helmert_transformation" VALUES('EPSG','3904','ED50 to WGS 84 (32)','Parameter values from ED87 to ETRS89 (1) (tfm code 4078), assuming that ED50 is identical to ED87 and ETRS89 to WGS 84. Errors caused by this assumption can reach 3-5m. Used by NAM for offshore operations until mid 2004, then replaced by tfm code 1311.','EPSG','9606','Position Vector transformation (geog2D domain)','EPSG','4230','EPSG','4326',5.0,-83.11,-97.38,-117.22,'EPSG','9001',0.0276,-0.2167,0.2147,'EPSG','9109',0.1218,'EPSG','9202',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,'Rws-Nld-Nsea',0);
