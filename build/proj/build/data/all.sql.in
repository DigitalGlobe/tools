INSERT INTO "grid_transformation" VALUES('EPSG','10618','CGVD28(HTv2.0) height to CGVD2013a(2002) height (1)','Equal to HT2_2002v70 hybrid geoid model minus CGG2013a geoid model (CT 10610 minus CT 10110). Specified interpolation CRS is NAD83(CSRS)v4, but NAD83(CSRS)v2 or any later realization may be used without error. Also used as CT 10519 from CGVD28 height.','EPSG','1126','Vertical change by geoid grid difference (NRCan)','EPSG','10588','EPSG','20034',0.02,'EPSG','1063','Geoid model difference file','HT2_2002v70_CGG2013a.byn',NULL,NULL,NULL,NULL,'EPSG','8246','NR-Can HT2 2002',0);
