INSERT INTO "grid_transformation" VALUES('EPSG','10629','ETRS89 to WC05-IRF (1)','In conjunction with the WC05-TM map projection (code 10631) applied to WC05-IRF (code 10628), emulates the WC05 Snake projection. Applied to ETRS89 (as realized through the OSNet v2009) defines WC05-IRF hence is errorless.						','EPSG','9615','NTv2','EPSG','4258','EPSG','10628',0.0,'EPSG','8656','Latitude and longitude difference file','TN15-ETRS89-to-WC05-IRF.gsb',NULL,NULL,NULL,NULL,NULL,NULL,'NR-Gbr WC05 OSNet2009',0);
