INSERT INTO "grid_transformation" VALUES('EPSG','10695','EUREF-FIN to N2000 height (1)','Replaced by EUREF-FIN to N2000 height (2) (code 10697). For reversible alternative see EUREF-FIN to EUREF-FIN + N2000 height (1) (code 10696). Derived through correction surface to the Nordic NKG2004-geoid model using 50 EUVN points. File also in ASCII.','EPSG','1123','Geographic3D to GravityRelatedHeight (gtg)','EPSG','10689','EPSG','3900',0.02,'EPSG','8666','Geoid (height correction) model file','fi_nls_fin2005n00.tif',NULL,NULL,NULL,NULL,NULL,NULL,'NLS-Fin 2005',0);
