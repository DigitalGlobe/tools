INSERT INTO "helmert_transformation" VALUES('EPSG','9684','ATRF2014 to GDA94 (1)','Concatenation of ATRF2014 to GDA2020 (1) (CT 9459) and GDA94 to GDA2020 (1) (CT 8048). Scale difference in ppb and rate in ppb/yr where 1/billion = 1E-9 or nm/m. See ATRF2014 to GDA94 (2) (CT 9685) for alternative for Australia with distortion modelling.','EPSG','1056','Time-dependent Coordinate Frame rotation (geocen)','EPSG','9307','EPSG','4938',0.035,-61.55,10.87,40.19,'EPSG','1025',39.4924,32.7221,32.8979,'EPSG','1031',9.994,'EPSG','1028',0.0,0.0,0.0,'EPSG','1027',1.50379,1.18346,1.20716,'EPSG','1032',0.0,'EPSG','1030',2020.0,'EPSG','1029',NULL,NULL,NULL,NULL,NULL,'ICSM-Aus Conf',0);
