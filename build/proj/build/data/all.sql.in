INSERT INTO "helmert_transformation" VALUES('EPSG','10777','ITRF2020 to KSA-GRF17 (1)','Derived by combining the IERS transformation from ITRF2020 to ITRF2014 at epoch 2017.0 (code 9991) with ITRF2014 to KSA-GRF17 transformation (code 9334).','EPSG','1053','Time-dependent Position Vector tfm (geocentric)','EPSG','9988','EPSG','9331',0.001,-1.4,-1.1,1.8,'EPSG','1025',0.0,0.0,0.0,'EPSG','1031',-0.42,'EPSG','1028',0.0,-0.1,0.2,'EPSG','1027',-1.199,0.107,-1.468,'EPSG','1032',0.0,'EPSG','1030',2017.0,'EPSG','1029',NULL,NULL,NULL,NULL,NULL,'GEOSA-Sau',0);
