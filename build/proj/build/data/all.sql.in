INSERT INTO "grid_transformation" VALUES('EPSG','10617','CGVD28(HTv2.0) height to CGVD2013a(1997) height (1)','Equal to HT2_1997 hybrid geoid model minus CGG2013a geoid model (CT 10609 minus CT 10111). Specified interpolation CRS is NAD83(CSRS)v3, but NAD83(CSRS)v2 or any later realization may be used without error. Also used as CT 10518 from CGVD28 height.','EPSG','1126','Vertical change by geoid grid difference (NRCan)','EPSG','10588','EPSG','20035',0.03,'EPSG','1063','Geoid model difference file','HT2_1997_CGG2013a.byn',NULL,NULL,NULL,NULL,'EPSG','8240','NR-Can HT2 1997',0);
