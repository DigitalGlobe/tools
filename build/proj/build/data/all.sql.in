INSERT INTO "grid_transformation" VALUES('EPSG','10294','ETRS89/DREF91/2016 to DHHN2016 height (1)','Accuracy approx. 1 cm in the lowlands, approx. 2 cm in the high mountains and 2 - 6 cm offshore. For reversible alternative to this transformation see ETRS89/DREF91/2016 to ETRS89/DREF91/2016 + DHHN2016 height (1) (code 10295).','EPSG','1082','Geographic3D to GravityRelatedHeight (txt)','EPSG','10283','EPSG','7837',0.02,'EPSG','8666','Geoid (height correction) model file','GCG2016.txt',NULL,NULL,NULL,NULL,NULL,NULL,'AdV-Deu 2016',0);
