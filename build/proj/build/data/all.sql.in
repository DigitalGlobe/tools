INSERT INTO "helmert_transformation" VALUES('EPSG','9686','GDA94 to WGS 84 (G1762) (1)','Concatenation of transformations codes 8048 and 8448 through GDA2020. Scale difference in ppb and rate in ppb/yr where 1/billion = 1E-9 or nm/m. See GDA94 to WGS 84 (G1762) (2) (CT 9687) for alternative for Australia with distortion modelling.','EPSG','1056','Time-dependent Coordinate Frame rotation (geocen)','EPSG','4938','EPSG','7664',0.25,61.55,-10.87,-40.19,'EPSG','1025',-39.4924,-32.7221,-32.8979,'EPSG','1031',-9.994,'EPSG','1028',0.0,0.0,0.0,'EPSG','1027',-1.50379,-1.18346,-1.20716,'EPSG','1032',0.0,'EPSG','1030',2020.0,'EPSG','1029',NULL,NULL,NULL,NULL,NULL,'ICSM-Aus Conf',0);
