INSERT INTO "grid_transformation" VALUES('EPSG','10197','ETRS89 to CWS13-IRF (1)','In conjunction with the CWS13-TM map projection (code 10198) applied to CWS13-IRF (code 10196), emulates the CWS13 Snake projection. Applied to ETRS89 (as realized through the OSNet v2009 CORS) defines CWS13-IRF hence is errorless.','EPSG','9615','NTv2','EPSG','4258','EPSG','10196',0.0,'EPSG','8656','Latitude and longitude difference file','TN15-ETRS89-to-CWS13-IRF.gsb',NULL,NULL,NULL,NULL,NULL,NULL,'NR-Gbr CWS13 OSNet2009',0);
