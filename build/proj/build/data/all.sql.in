INSERT INTO "grid_transformation" VALUES('EPSG','15786','AGD66 to WGS 84 (17)','Parameter values from AGD66 to GDA94 (11) (code 1803). Approximation assuming WGS 84 is equivalent to GDA94; ignores the low accuracy of the WGS 84 ensemble and the inconsistent application of tectonic plate motion to WGS 84 data.','EPSG','9615','NTv2','EPSG','4202','EPSG','4326',2.9,'EPSG','8656','Latitude and longitude difference file','A66 National (13.09.01).gsb',NULL,NULL,NULL,NULL,NULL,NULL,'OGP-Aus 0.1m',0);
