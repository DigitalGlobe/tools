INSERT INTO "grid_transformation" VALUES('EPSG','10666','ETRF2000 to EOMA 1980 height (2)','Emulation to better than 7mm of the official SGO EHT model (CT code 10661). The geoid height values were obtained from the online EHT service. For reversible alternative to this transformation see ETRF2000 to ETRF2000 + EOMA 1980 height (2) (code 10667).','EPSG','1123','Geographic3D to GravityRelatedHeight (gtg)','EPSG','7931','EPSG','5787',0.06,'EPSG','8666','Geoid (height correction) model file','hu_bme_geoid2014.tif',NULL,NULL,NULL,NULL,NULL,NULL,'BME-Hun geoid14',0);
