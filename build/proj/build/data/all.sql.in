INSERT INTO "conversion" VALUES('EPSG','18201','Palestine Grid','Replaced (i) in Israel by Israeli CS (proj code 18203) which adds 1 million to FN; (ii) for AMS by Palestine Belt (code18202) which adds 1 million to FN and changes method to TM. Also encountered as a TM projection without change to FN (see code 7141).','EPSG','9806','Cassini-Soldner','EPSG','8801','Latitude of natural origin',31.4402749,'EPSG','9110','EPSG','8802','Longitude of natural origin',35.124349,'EPSG','9110','EPSG','8806','False easting',170251.555,'EPSG','9001','EPSG','8807','False northing',126867.909,'EPSG','9001',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0);
