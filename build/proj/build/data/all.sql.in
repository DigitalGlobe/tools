INSERT INTO "grid_transformation" VALUES('EPSG','10210','ETRS89 to GWPBS22-IRF (1)','In conjunction with the GW22-LCC map projection (code 10211) applied to GWPBS22-IRF (code 10209), emulates the GWPBS22 Snake projection. Applied to ETRS89 (as realized through the OSNet v2009) defines GWPBS22-IRF hence is errorless.						','EPSG','9615','NTv2','EPSG','4258','EPSG','10209',0.0,'EPSG','8656','Latitude and longitude difference file','TN15-ETRS89-to-GWPBS22-IRF.gsb',NULL,NULL,NULL,NULL,NULL,NULL,'NR-Gbr GWPBS22 OSNet2009',0);
