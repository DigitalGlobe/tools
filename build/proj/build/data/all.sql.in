INSERT INTO "grid_transformation" VALUES('EPSG','9890','RGF93 v2 to NTF (2)','Emulation of transformation NTF to RGF93 v2 (1), code 9888. Note that grid file parameters are of opposite sign. Parameter file is from RGF93 v1 to NTF (code 15958), assuming that RGF93 v1 is equivalent to RGF93 v2 within the accuracy of the CT.','EPSG','9615','NTv2','EPSG','9777','EPSG','4275',1.0,'EPSG','8656','Latitude and longitude difference file','rgf93_ntf.gsb',NULL,NULL,NULL,NULL,NULL,NULL,'ESRI-Fra 1m emulation',0);
