INSERT INTO "helmert_transformation" VALUES('EPSG','10098','KKJ to EUREF-FIN (2)','In most areas accuracy is approximately 0.5m although in some areas it is in the order of 2m. Replaces KKJ to ETRS89 (1) (code 1638). YKJ to ETRS-TM35FIN (code 10703) using the TINshift method is recommended in preference to this transformation.','EPSG','9607','Coordinate Frame rotation (geog2D domain)','EPSG','4123','EPSG','10690',0.5,-96.062,-82.428,-121.753,'EPSG','9001',-4.801,-0.345,1.376,'EPSG','9104',1.496,'EPSG','9202',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,'NLS-Fin JHS153',0);
