INSERT INTO "grid_transformation" VALUES('EPSG','10319','RGNC15 to NGNC08 height (1)','Geoid model RANC15 realizes NGNC08 height (CRS code 9351) to a precision of 2-5cm. Replaces RANC08. For reversible alternative to this transformation see RGNC15 (lon-lat) to RGNC15 (lon-lat) + NGNC08 height (1) (code 10320).','EPSG','1073','Geographic3D to GravityRelatedHeight (IGN2009)','EPSG','10311','EPSG','9351',0.03,'EPSG','8666','Geoid (height correction) model file','RANC15.tac',NULL,NULL,NULL,NULL,NULL,NULL,'BGN-Ncl RANC15',0);
