INSERT INTO "grid_transformation" VALUES('EPSG','9282','Amersfoort to ETRS89 (9)','Defines Amersfoort. Horizontal component of official transformation RDNAPTRANS(TM)2018. Replaces Amersfoort to ETRS89 (7) (tfm code 7000).','EPSG','9615','NTv2','EPSG','4289','EPSG','4258',0.0,'EPSG','8656','Latitude and longitude difference file','rdtrans2018.gsb',NULL,NULL,NULL,NULL,NULL,NULL,'NSGI-Nld 2018',0);
