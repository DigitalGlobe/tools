INSERT INTO "grid_transformation" VALUES('EPSG','9124','ITRF2008 to CGVD2013(CGG2013) height (1)','Uses CGG2013 model derived through NAD83(CSRS)v6. In ITRF the CGVD2013 geoid velocity is not zero so CGVD2013 heights derived through ITRF change with respect to NAD83(CSRS)v6: CGRSC recommends using NAD83(CSRS)v6 (code 9246). Replaced by CT code 9125.','EPSG','1060','Geographic3D to GravityRelatedHeight (NRCan byn)','EPSG','7911','EPSG','6647',0.03,'EPSG','8666','Geoid (height correction) model file','CGG2013i08.byn',NULL,NULL,NULL,NULL,NULL,NULL,'NRC Can CGG2013',0);
