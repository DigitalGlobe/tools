INSERT INTO "helmert_transformation" VALUES('EPSG','10180','IGb14 to IGS20 (1)','Scale difference in ppb and scale difference rate in ppb/yr where 1/billion = 1E-9 or nm/m. Parameter values from ITRF2014 to ITRF2020 (1) (code 9991) as IGb14 is aligned to ITRF2014 and IGS20 is aligned to ITRF2020.','EPSG','1053','Time-dependent Position Vector tfm (geocentric)','EPSG','9378','EPSG','10176',0.001,1.4,0.9,-1.4,'EPSG','1025',0.0,0.0,0.0,'EPSG','1031',0.42,'EPSG','1028',0.0,0.1,-0.2,'EPSG','1027',0.0,0.0,0.0,'EPSG','1032',0.0,'EPSG','1030',2015.0,'EPSG','1029',NULL,NULL,NULL,NULL,NULL,'IGS-Wld',0);
