INSERT INTO "grid_transformation" VALUES('EPSG','10205','ETRS89 to DIBA15-IRF (1)','In conjunction with the DIBA15-TM map projection (code 10206) applied to DIBA15-IRF (code 10204), emulates the DIBA15 Snake projection. Applied to ETRS89 (as realized through the OSNet v2009 CORS) defines DIBA15-IRF hence is errorless.','EPSG','9615','NTv2','EPSG','4258','EPSG','10204',0.0,'EPSG','8656','Latitude and longitude difference file','TN15-ETRS89-to-DIBA15-IRF.gsb',NULL,NULL,NULL,NULL,NULL,NULL,'NR-Gbr DIBA15 OSNet2009',0);
