INSERT INTO "grid_transformation" VALUES('EPSG','10152','ETRS89 to ETRS89 + MSL UK & Ireland VORF08 depth (1)','Reversible alternative to ETRS89 to MSL UK & Ireland VORF08 depth (1) (code 10154). VORF08 usually delivered in tiles covering 2° by 2° or less. Transformation accuracy at 2-sigma is 0.20 metres (inshore) and 0.30 metres (offshore).','EPSG','1115','Geog3D to Geog2D+Depth (txt)','EPSG','4937','EPSG','10156',0.3,'EPSG','8666','Geoid (height correction) model file','VORF-UK08_ETRF_to_MSL.vrf',NULL,NULL,NULL,NULL,'EPSG','4258','UKHO-VORF08',0);
